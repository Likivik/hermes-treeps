# Copy to your Hermes home .env (or use `hermes config set <KEY> <value>`).
# Only FORGEJO_TOKEN is needed for the Forgejo catalogue; everything else is
# optional and overrides the same-named setting from config.yaml.

# The Forgejo API token. The manifest declares it as
# `forgejo_token: {type: secret, env: FORGEJO_TOKEN}`, so the Desktop
# Settings -> Plugins -> forgejo_token field writes THIS name.
FORGEJO_TOKEN=

# Base URL of the Forgejo instance (not a secret; also settable as
# forgejo_url in plugins.entries.hermes-treeps.settings).
FORGEJO_URL=
